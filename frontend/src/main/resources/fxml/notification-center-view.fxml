<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.combined.frontend.controller.NotificationCenterController"
            prefWidth="600" prefHeight="400">
    <top>
        <HBox spacing="10" style="-fx-padding: 10; -fx-background-color: #f7f7f7;">
            <Label text="Notification Center" style="-fx-font-size: 18px; -fx-font-weight: bold;"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Button fx:id="clearButton" text="Clear" onAction="#handleClear"/>
        </HBox>
    </top>
    <center>
        <ListView fx:id="notificationsList"/>
    </center>
    <bottom>
        <Label fx:id="statusLabel" style="-fx-padding: 8; -fx-text-fill: #555;"/>
    </bottom>
</BorderPane>
