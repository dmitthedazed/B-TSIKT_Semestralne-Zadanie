<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx"
    xmlns:fx="http://javafx.com/fxml"
    fx:controller="com.combined.frontend.controller.AuthViewController"
    alignment="CENTER"
    spacing="12"
    style="-fx-padding: 30;">

    <children>
        <Label text="TaskBoard" style="-fx-font-size: 30px; -fx-font-weight: bold; -fx-text-fill: #1e1e1e;" />
        <StackPane alignment="CENTER" VBox.vgrow="ALWAYS"
                   prefWidth="520" maxWidth="520" minWidth="520"
                   prefHeight="600" maxHeight="600" minHeight="600">
            <fx:include source="login.fxml" fx:id="loginView" />
            <fx:include source="register.fxml" fx:id="registerView" />
        </StackPane>
    </children>
</VBox>
