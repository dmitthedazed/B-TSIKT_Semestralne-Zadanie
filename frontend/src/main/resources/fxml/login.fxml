<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>

<StackPane xmlns="http://javafx.com/javafx"
           xmlns:fx="http://javafx.com/fxml"
           fx:controller="com.combined.frontend.controller.LoginController"
           style="-fx-padding: 30;">

    <VBox alignment="CENTER" spacing="18"
          maxWidth="420" prefWidth="420" minWidth="420"
          prefHeight="560" minHeight="560"
          style="-fx-background-color: white; -fx-padding: 32 32 28 32; -fx-background-radius: 10; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.12), 18, 0.2, 0, 6);">
        <Label text="Welcome back"
               style="-fx-font-size: 26px; -fx-font-weight: bold; -fx-text-fill: #222;" />
        <Label text="Sign in with your email or username to continue"
               wrapText="true"
               style="-fx-text-fill: #666; -fx-font-size: 13px;" />

        <VBox spacing="12" maxWidth="Infinity" VBox.vgrow="NEVER">
            <TextField fx:id="emailField" promptText="Email or username" maxWidth="Infinity"
                       style="-fx-padding: 12 14; -fx-min-height: 42;" />
            <PasswordField fx:id="passwordField" promptText="Password" maxWidth="Infinity"
                           style="-fx-padding: 12 14; -fx-min-height: 42;" />
        </VBox>

        <Button text="Sign In"
                onAction="#handleLogin"
                maxWidth="Infinity"
                style="-fx-font-size: 15px; -fx-padding: 12; -fx-background-radius: 12;" />

        <Button onAction="#handleGoogleLogin"
                maxWidth="Infinity"
                style="-fx-padding: 0; -fx-background-color: transparent; -fx-border-color: transparent;">
            <graphic>
                <ImageView fitWidth="220" preserveRatio="true" smooth="true">
                    <image>
                        <Image url="@/img/google-signin-light.png"/>
                    </image>
                </ImageView>
            </graphic>
        </Button>

        <VBox spacing="6" alignment="CENTER">
            <Label text="First time here?" style="-fx-text-fill: #444; -fx-font-size: 12px;" />
            <HBox spacing="10" alignment="CENTER">
                <Hyperlink text="Register" onAction="#switchToRegister" />
                <Label text="|" style="-fx-text-fill: #888;" />
                <Hyperlink text="Try demo" onAction="#handleTryDemo" />
            </HBox>
        </VBox>
    </VBox>
</StackPane>
