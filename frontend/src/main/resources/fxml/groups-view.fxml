<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.combined.frontend.controller.GroupsController"
      spacing="10">

    <padding>
        <Insets top="10" right="10" bottom="10" left="10"/>
    </padding>

    <children>
        <HBox spacing="10" alignment="CENTER_LEFT">
            <Label text="Groups Management" style="-fx-font-size: 16px; -fx-font-weight: bold;"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Button text="Create Group" onAction="#onCreateGroupClick"/>
            <Button text="Refresh" onAction="#onRefreshClick"/>
        </HBox>

        <TabPane fx:id="groupsTabPane" VBox.vgrow="ALWAYS">
            <Tab text="My Groups" id="myGroupsTab">
                <content>
                    <TableView fx:id="myGroupsTable" VBox.vgrow="ALWAYS">
                        <columns>
                            <TableColumn fx:id="myGroupNameColumn" text="Name" prefWidth="150"/>
                            <TableColumn fx:id="myGroupDescriptionColumn" text="Description" prefWidth="250"/>
                            <TableColumn fx:id="myGroupCreatedByColumn" text="Created by" prefWidth="100"/>
                            <TableColumn fx:id="myGroupMembersColumn" text="Members" prefWidth="80"/>
                            <TableColumn fx:id="myGroupOpenTasksColumn" text="Open Tasks" prefWidth="90"/>
                            <TableColumn fx:id="myGroupActionColumn" text="Action" prefWidth="80"/>
                        </columns>
                    </TableView>
                </content>
            </Tab>
            <Tab text="All Groups" id="allGroupsTab">
                <content>
                    <TableView fx:id="allGroupsTable" VBox.vgrow="ALWAYS">
                        <columns>
                            <TableColumn fx:id="allGroupNameColumn" text="Name" prefWidth="150"/>
                            <TableColumn fx:id="allGroupDescriptionColumn" text="Description" prefWidth="250"/>
                            <TableColumn fx:id="allGroupCreatedByColumn" text="Created by" prefWidth="100"/>
                            <TableColumn fx:id="allGroupMembersColumn" text="Members" prefWidth="80"/>
                            <TableColumn fx:id="allGroupActionColumn" text="Action" prefWidth="80"/>
                        </columns>
                    </TableView>
                </content>
            </Tab>
        </TabPane>

        <Label fx:id="statusLabel" text="" style="-fx-text-fill: red;"/>
    </children>
</VBox>
