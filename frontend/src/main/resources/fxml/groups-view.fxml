<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.control.ScrollPane?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.combined.frontend.controller.GroupsController"
      spacing="10">

    <padding>
        <Insets top="10" right="10" bottom="10" left="10"/>
    </padding>

    <children>
        <HBox spacing="10" alignment="CENTER_LEFT">
            <Label text="Groups Management" style="-fx-font-size: 16px; -fx-font-weight: bold;"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Button text="Create Group" onAction="#onCreateGroupClick"/>
            <Button text="Refresh" onAction="#onRefreshClick"/>
        </HBox>

        <TabPane fx:id="groupsTabPane" VBox.vgrow="ALWAYS">
            <Tab text="My Groups" id="myGroupsTab" closable="false">
                <content>
                    <ScrollPane fitToWidth="true" fitToHeight="true" hbarPolicy="NEVER">
                        <content>
                            <FlowPane fx:id="myGroupsFlow" hgap="12" vgap="12" prefWrapLength="800">
                                <padding>
                                    <Insets top="10" right="10" bottom="10" left="10"/>
                                </padding>
                            </FlowPane>
                        </content>
                    </ScrollPane>
                </content>
            </Tab>
            <Tab text="Available Groups" id="allGroupsTab" closable="false">
                <content>
                    <ScrollPane fitToWidth="true" fitToHeight="true" hbarPolicy="NEVER">
                        <content>
                            <FlowPane fx:id="allGroupsFlow" hgap="12" vgap="12" prefWrapLength="800">
                                <padding>
                                    <Insets top="10" right="10" bottom="10" left="10"/>
                                </padding>
                            </FlowPane>
                        </content>
                    </ScrollPane>
                </content>
            </Tab>
        </TabPane>

        <Label fx:id="statusLabel" text="" style="-fx-text-fill: red;"/>
    </children>
</VBox>
