<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.combined.frontend.controller.OverviewController"
      spacing="15" alignment="TOP_LEFT">

    <padding>
        <Insets top="20" right="20" bottom="20" left="20"/>
    </padding>

    <Label text="Group Overview" style="-fx-font-size: 18px; -fx-font-weight: bold;"/>

    <GridPane hgap="10" vgap="10">
        <columnConstraints>
            <ColumnConstraints halignment="RIGHT" prefWidth="150"/>
            <ColumnConstraints hgrow="ALWAYS" prefWidth="250"/>
        </columnConstraints>

        <Label text="Group Name:" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
        <Label fx:id="groupNameLabel" GridPane.rowIndex="0" GridPane.columnIndex="1"/>

        <Label text="Description:" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
        <Label fx:id="groupDescriptionLabel" GridPane.rowIndex="1" GridPane.columnIndex="1" wrapText="true"/>

        <Label text="Created By:" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
        <Label fx:id="createdByLabel" GridPane.rowIndex="2" GridPane.columnIndex="1"/>

        <Label text="Members Count:" GridPane.rowIndex="3" GridPane.columnIndex="0"/>
        <Label fx:id="membersCountLabel" GridPane.rowIndex="3" GridPane.columnIndex="1"/>
    </GridPane>

    <Separator/>

    <Label text="Task Status Summary" style="-fx-font-size: 16px; -fx-font-weight: bold;"/>
    <GridPane fx:id="taskStatusGrid" hgap="10" vgap="5">
        <!-- Task status counts will be added here dynamically -->
    </GridPane>

    <Separator/>

    <Label text="Upcoming Deadlines" style="-fx-font-size: 16px; -fx-font-weight: bold;"/>
    <ListView fx:id="upcomingDeadlinesList" prefHeight="150"/>

    <Label fx:id="statusLabel" text="" style="-fx-text-fill: red;"/>

</VBox>
