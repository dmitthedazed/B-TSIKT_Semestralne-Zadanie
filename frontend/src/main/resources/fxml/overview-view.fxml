<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.combined.frontend.controller.OverviewController"
      spacing="14" alignment="TOP_LEFT">

    <padding>
        <Insets top="16" right="16" bottom="16" left="16"/>
    </padding>

    <HBox spacing="14">
        <VBox spacing="8" prefWidth="320"
              style="-fx-background-color: #e6f1f7; -fx-border-color: #b9d4e5; -fx-border-radius: 10; -fx-background-radius: 10; -fx-padding: 14;">
            <Label text="Group Overview" style="-fx-font-size: 16px; -fx-font-weight: bold;"/>
            <GridPane hgap="8" vgap="6">
                <columnConstraints>
                    <ColumnConstraints halignment="RIGHT" prefWidth="110"/>
                    <ColumnConstraints hgrow="ALWAYS" prefWidth="200"/>
                </columnConstraints>

                <Label text="Group Name:" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                <Label fx:id="groupNameLabel" GridPane.rowIndex="0" GridPane.columnIndex="1"/>

                <Label text="Description:" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
                <Label fx:id="groupDescriptionLabel" GridPane.rowIndex="1" GridPane.columnIndex="1" wrapText="true"/>

                <Label text="Created By:" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
                <Label fx:id="createdByLabel" GridPane.rowIndex="2" GridPane.columnIndex="1"/>

                <Label text="Members:" GridPane.rowIndex="3" GridPane.columnIndex="0"/>
                <Label fx:id="membersCountLabel" GridPane.rowIndex="3" GridPane.columnIndex="1"/>
            </GridPane>
        </VBox>

        <VBox spacing="8" VBox.vgrow="ALWAYS"
              style="-fx-background-color: #e6f1f7; -fx-border-color: #b9d4e5; -fx-border-radius: 10; -fx-background-radius: 10; -fx-padding: 14;"
              HBox.hgrow="ALWAYS">
            <Label text="Upcoming Deadlines" style="-fx-font-size: 16px; -fx-font-weight: bold;"/>
            <ListView fx:id="upcomingDeadlinesList" prefHeight="180" VBox.vgrow="ALWAYS"/>
        </VBox>
    </HBox>

    <HBox spacing="14">
        <VBox spacing="8" prefWidth="320"
              style="-fx-background-color: #e6f1f7; -fx-border-color: #b9d4e5; -fx-border-radius: 10; -fx-background-radius: 10; -fx-padding: 14;">
            <Label text="Task Status Summary" style="-fx-font-size: 16px; -fx-font-weight: bold;"/>
            <HBox spacing="10">
                <Label fx:id="openCountLabel" text="Open: 0" style="-fx-background-color: white; -fx-border-color: #d0e3ef; -fx-border-radius: 6; -fx-background-radius: 6; -fx-padding: 6 8;"/>
                <Label fx:id="inProgressCountLabel" text="In Progress: 0" style="-fx-background-color: white; -fx-border-color: #d0e3ef; -fx-border-radius: 6; -fx-background-radius: 6; -fx-padding: 6 8;"/>
                <Label fx:id="doneCountLabel" text="Done: 0" style="-fx-background-color: white; -fx-border-color: #d0e3ef; -fx-border-radius: 6; -fx-background-radius: 6; -fx-padding: 6 8;"/>
            </HBox>
            <GridPane fx:id="taskStatusGrid" hgap="10" vgap="8">
                <!-- Task status counts will be added here dynamically -->
            </GridPane>
            <Label text="Tasks per Member" style="-fx-font-size: 13px; -fx-font-weight: bold;"/>
            <ListView fx:id="memberLoadList" prefHeight="120" VBox.vgrow="ALWAYS"/>
        </VBox>

        <VBox spacing="8" VBox.vgrow="ALWAYS"
              style="-fx-background-color: #e6f1f7; -fx-border-color: #b9d4e5; -fx-border-radius: 10; -fx-background-radius: 10; -fx-padding: 14;"
              HBox.hgrow="ALWAYS">
            <Label text="Resources" style="-fx-font-size: 16px; -fx-font-weight: bold;"/>
            <ListView fx:id="materialsList" prefHeight="180" VBox.vgrow="ALWAYS"/>
        </VBox>
    </HBox>

    <VBox spacing="8"
          style="-fx-background-color: #e6f1f7; -fx-border-color: #b9d4e5; -fx-border-radius: 10; -fx-background-radius: 10; -fx-padding: 14;">
        <fx:include source="statistics-view.fxml" fx:id="statsSection"/>
    </VBox>

    <Label fx:id="statusLabel" text="" style="-fx-text-fill: red;"/>

</VBox>
