<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.combined.frontend.controller.RegisterController"
      alignment="CENTER" spacing="15" style="-fx-padding: 40;">

    <Label text="Create Account" style="-fx-font-size: 24px; -fx-font-weight: bold;"/>

    <GridPane hgap="10" vgap="10" alignment="CENTER">
        <Label text="First Name:" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
        <TextField fx:id="firstNameField" promptText="Enter your first name" GridPane.rowIndex="0" GridPane.columnIndex="1"/>

        <Label text="Last Name (Optional):" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
        <TextField fx:id="lastNameField" promptText="Enter your last name" GridPane.rowIndex="1" GridPane.columnIndex="1"/>

        <Label text="Username:" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
        <TextField fx:id="nicknameField" promptText="Choose a unique username" GridPane.rowIndex="2" GridPane.columnIndex="1"/>

        <Label text="Email Address:" GridPane.rowIndex="3" GridPane.columnIndex="0"/>
        <TextField fx:id="emailField" promptText="Enter your email" GridPane.rowIndex="3" GridPane.columnIndex="1"/>

        <Label text="Password:" GridPane.rowIndex="4" GridPane.columnIndex="0"/>
        <PasswordField fx:id="passwordField" promptText="6+ characters" GridPane.rowIndex="4" GridPane.columnIndex="1"/>

        <Label text="Confirm Password:" GridPane.rowIndex="5" GridPane.columnIndex="0"/>
        <PasswordField fx:id="confirmPasswordField" promptText="Repeat your password" GridPane.rowIndex="5" GridPane.columnIndex="1"/>
    </GridPane>

    <Button text="Register" onAction="#handleRegister" style="-fx-font-size: 14px;"/>
    <Hyperlink text="Already have an account? Login" onAction="#switchToLogin"/>

</VBox>
