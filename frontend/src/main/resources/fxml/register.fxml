<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<StackPane xmlns="http://javafx.com/javafx"
           xmlns:fx="http://javafx.com/fxml"
           fx:controller="com.combined.frontend.controller.RegisterController"
           style="-fx-padding: 30;">

    <VBox alignment="CENTER" spacing="18"
          maxWidth="420" prefWidth="420" minWidth="420"
          prefHeight="560" minHeight="560"
          style="-fx-background-color: white; -fx-padding: 32 32 28 32; -fx-background-radius: 10; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.12), 18, 0.2, 0, 6);">

        <Label text="Create your account"
               style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #222;" />
        <Label text="Join the workspace and start collaborating"
               wrapText="true"
               style="-fx-text-fill: #666; -fx-font-size: 13px;" />

        <VBox spacing="10" maxWidth="Infinity">
            <TextField fx:id="firstNameField" promptText="First name" style="-fx-padding: 12 14; -fx-min-height: 42;" />
            <TextField fx:id="lastNameField" promptText="Last name (optional)" style="-fx-padding: 12 14; -fx-min-height: 42;" />
            <TextField fx:id="nicknameField" promptText="Username" style="-fx-padding: 12 14; -fx-min-height: 42;" />
            <TextField fx:id="emailField" promptText="Email address" style="-fx-padding: 12 14; -fx-min-height: 42;" />
            <PasswordField fx:id="passwordField" promptText="Password (6+ characters)" style="-fx-padding: 12 14; -fx-min-height: 42;" />
            <PasswordField fx:id="confirmPasswordField" promptText="Confirm password" style="-fx-padding: 12 14; -fx-min-height: 42;" />
        </VBox>

        <Button text="Register"
                onAction="#handleRegister"
                maxWidth="Infinity"
                style="-fx-font-size: 15px; -fx-padding: 12; -fx-background-radius: 12;" />

        <Hyperlink text="Already have an account? Login"
                   onAction="#switchToLogin"
                   style="-fx-font-size: 12px;" />
    </VBox>
</StackPane>
