<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.combined.frontend.controller.MainController"
            prefHeight="700.0" prefWidth="1000.0">

    <!-- Top Bar -->
    <top>
        <HBox alignment="CENTER_LEFT" spacing="10" style="-fx-padding: 10; -fx-background-color: #f0f0f0; -fx-border-color: #ccc; -fx-border-width: 0 0 1 0;">
            <Label fx:id="sectionTitleLabel" text="Dashboard" style="-fx-font-size: 20px; -fx-font-weight: bold;"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Label fx:id="usernameLabel" text="Welcome, User!" style="-fx-font-size: 16px;"/>
            <Button text="Logout" onAction="#handleLogout"/>
        </HBox>
    </top>

    <!-- Left Sidebar -->
    <left>
        <VBox spacing="10" style="-fx-padding: 15; -fx-background-color: #e0e0e0; -fx-border-color: #ccc; -fx-border-width: 0 1 0 0;" prefWidth="180">
            <Label text="Navigation" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-padding: 0 0 5 0;"/>
            <Button fx:id="myGroupsButton" text="Groups" prefWidth="150" onAction="#handleSidebarNavigation"/>
            <Button fx:id="tasksAllButton" text="Tasks" prefWidth="150" onAction="#handleSidebarNavigation"/>
            <Button fx:id="statisticsButton" text="Statistics" prefWidth="150" onAction="#handleSidebarNavigation"/>
            <Button fx:id="notificationsButton" text="Notifications" prefWidth="150" onAction="#handleSidebarNavigation"/>
            <Button fx:id="profileButton" text="Profile" prefWidth="150" onAction="#handleSidebarNavigation"/>
            <Button fx:id="logoutSidebarButton" text="Logout" prefWidth="150" onAction="#handleLogout"/>
        </VBox>
    </left>

    <!-- Central Content Area -->
    <center>
        <StackPane fx:id="contentPane" style="-fx-background-color: lightblue;"/>
    </center>
</BorderPane>
