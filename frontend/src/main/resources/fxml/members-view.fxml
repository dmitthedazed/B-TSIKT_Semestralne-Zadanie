<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.combined.frontend.controller.MembersController"
      spacing="10">

    <padding>
        <Insets top="10" right="10" bottom="10" left="10"/>
    </padding>

    <children>
        <HBox spacing="10" alignment="CENTER_LEFT">
            <Label text="Group Members" style="-fx-font-size: 16px; -fx-font-weight: bold;"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Button fx:id="addMemberButton" text="Add Member" onAction="#onAddMemberClick"/>
            <Button fx:id="refreshButton" text="Refresh" onAction="#onRefreshClick"/>
        </HBox>

        <ListView fx:id="membersListView" VBox.vgrow="ALWAYS"/>

        <Label fx:id="statusLabel" text="" style="-fx-text-fill: red;"/>
    </children>
</VBox>
