<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<ScrollPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fitToWidth="true"
            fx:controller="com.combined.frontend.controller.ProfileController">
    <content>
        <VBox spacing="18" alignment="TOP_CENTER" style="-fx-padding: 20;">
            <Label text="Profile" style="-fx-font-size: 24px; -fx-font-weight: bold;"/>

            <TitledPane text="Profile information" expanded="true">
                <content>
                    <GridPane hgap="12" vgap="10" style="-fx-padding: 12;">
                        <columnConstraints>
                            <ColumnConstraints halignment="RIGHT" prefWidth="140"/>
                            <ColumnConstraints hgrow="ALWAYS" prefWidth="300"/>
                        </columnConstraints>
                        <Label text="First name:" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                        <TextField fx:id="firstNameField" GridPane.rowIndex="0" GridPane.columnIndex="1"/>

                        <Label text="Last name:" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
                        <TextField fx:id="lastNameField" GridPane.rowIndex="1" GridPane.columnIndex="1"/>

                        <Label text="Nickname:" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
                        <TextField fx:id="nicknameField" GridPane.rowIndex="2" GridPane.columnIndex="1" editable="false"/>

                        <Label text="Email:" GridPane.rowIndex="3" GridPane.columnIndex="0"/>
                        <TextField fx:id="emailField" GridPane.rowIndex="3" GridPane.columnIndex="1" editable="false"/>

                        <Label text="User ID:" GridPane.rowIndex="4" GridPane.columnIndex="0"/>
                        <TextField fx:id="userIdField" GridPane.rowIndex="4" GridPane.columnIndex="1" editable="false"/>
                    </GridPane>
                </content>
            </TitledPane>

            <Button text="Save changes" onAction="#handleUpdateProfile" maxWidth="200"/>

            <TitledPane text="Security" expanded="true">
                <content>
                    <GridPane hgap="12" vgap="10" style="-fx-padding: 12;">
                        <columnConstraints>
                            <ColumnConstraints halignment="RIGHT" prefWidth="160"/>
                            <ColumnConstraints hgrow="ALWAYS" prefWidth="260"/>
                        </columnConstraints>
                        <Label text="Current password:" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                        <PasswordField fx:id="currentPasswordField" GridPane.rowIndex="0" GridPane.columnIndex="1"/>

                        <Label text="New password:" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
                        <PasswordField fx:id="newPasswordField" GridPane.rowIndex="1" GridPane.columnIndex="1"/>

                        <Label text="Confirm new password:" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
                        <PasswordField fx:id="confirmPasswordField" GridPane.rowIndex="2" GridPane.columnIndex="1"/>
                    </GridPane>
                </content>
            </TitledPane>

            <Button text="Change password" onAction="#handleChangePassword" maxWidth="200"/>

            <Label fx:id="statusLabel" text="" style="-fx-text-fill: #2563eb;"/>
        </VBox>
    </content>
</ScrollPane>
