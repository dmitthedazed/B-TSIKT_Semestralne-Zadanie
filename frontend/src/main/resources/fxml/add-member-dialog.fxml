<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<DialogPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.combined.frontend.controller.AddMemberController">

    <content>
        <VBox spacing="12">
            <padding>
                <Insets top="12" right="12" bottom="12" left="12"/>
            </padding>

            <Label text="Add member" style="-fx-font-size: 14px; -fx-font-weight: bold;"/>

            <GridPane hgap="10" vgap="12">
                <columnConstraints>
                    <ColumnConstraints minWidth="130" halignment="RIGHT"/>
                    <ColumnConstraints hgrow="ALWAYS"/>
                </columnConstraints>

                <Label text="Email / username" style="-fx-text-fill: #444; -fx-font-weight: bold;" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                <TextField fx:id="userEmailField" promptText="Enter one email or nickname" GridPane.rowIndex="0" GridPane.columnIndex="1" prefWidth="280"/>

                <Label text="Add multiple" style="-fx-text-fill: #444; -fx-font-weight: bold;" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
                <TextArea fx:id="advancedIdentifiersField" promptText="user1@example.com, user2@example.com or one per line" GridPane.rowIndex="1" GridPane.columnIndex="1"
                          prefRowCount="5" wrapText="true"/>
            </GridPane>

            <Label text="Comma or newline separated identifiers. Missing ones will be reported." style="-fx-text-fill: #666;"/>

            <Label fx:id="errorMessageLabel" textFill="red"/>
        </VBox>
    </content>

    <buttonTypes>
        <ButtonType fx:constant="CANCEL"/>
        <ButtonType text="Add" buttonData="OK_DONE"/>
    </buttonTypes>

</DialogPane>
