<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<DialogPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.combined.frontend.controller.AddMemberController">

    <content>
        <VBox spacing="10">
            <padding>
                <Insets top="10" right="10" bottom="10" left="10"/>
            </padding>

            <Label text="Add member by email" style="-fx-font-size: 14px; -fx-font-weight: bold;"/>

            <GridPane hgap="10" vgap="10">
                <Label text="Email:" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                <TextField fx:id="userEmailField" promptText="Enter user email" GridPane.rowIndex="0" GridPane.columnIndex="1" prefWidth="240"/>
            </GridPane>

            <TitledPane text="Advanced adding" expanded="false">
                <content>
                    <VBox spacing="6">
                        <Label text="Enter multiple emails/nicknames (comma or newline separated)."/>
                        <TextArea fx:id="advancedIdentifiersField" promptText="user1@example.com, user2@example.com or one per line" prefRowCount="4" wrapText="true"/>
                    </VBox>
                </content>
            </TitledPane>

            <Label fx:id="errorMessageLabel" textFill="red"/>
        </VBox>
    </content>

    <buttonTypes>
        <ButtonType fx:constant="CANCEL"/>
        <ButtonType text="Add" buttonData="OK_DONE"/>
    </buttonTypes>

</DialogPane>
